generator client {
  provider      = "prisma-client-js"
  // Native covers local development; the musl target is what the Alpine
  // container actually runs on.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(uuid())
  slug      String    @unique
  name      String
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  products  Product[]

  // Optional on purpose: left empty, the landing falls back to the first photo
  // of the first product in the category, so a new category is never a hole in
  // the homepage grid. SetNull rather than Restrict is a backstop only — the
  // media library already refuses to delete a file a category points at.
  coverMediaId String?
  cover        Media?  @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  price       Decimal? @db.Decimal(12, 0)
  salePrice   Decimal? @db.Decimal(12, 0)

  // When salePrice is allowed to apply. Both nullable and independent: a sale
  // with neither runs until the owner removes it (the behaviour before these
  // existed), one with only a start is "from X onwards", one with only an end
  // is "until Y".
  //
  // Instants, stored UTC like every other timestamp here. The shop thinks in
  // Vietnam time and the admin converts at the edge — the server never guesses
  // a zone, so the stack keeps working whatever TZ the container happens to
  // run under.
  saleStartsAt DateTime?
  saleEndsAt   DateTime?
  // Manually-entered display label only (e.g. "Còn 5 cái" / "Hết hàng") — never computed from real orders.
  stockLabel   String?
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  // Names the owner chooses for the two ways this product varies — "Dung
  // tích"/"Màu", "Size dài"/null. Free text rather than a fixed size+colour
  // pair because this catalogue varies by volume and length far more often
  // than by clothing size, and a fixed label would push the owner straight
  // back to typing "10ml" into a box called Size.
  //
  // Two at most, like the marketplaces the shop owner already sells on. A
  // third axis multiplies the grid they have to fill by hand for a case that
  // has not appeared in 211 products.
  option1Name String?
  option2Name String?

  // Which group's values carry their own photo, 1 or 2; null when none do.
  // Only one group can: a customer who picked a colour and a size would
  // otherwise have two photos competing for the same frame, and the marketplaces
  // solve that by allowing images on their first tier only. The group is the
  // owner's choice here rather than fixed, because group 1 is free text and is
  // "Dung tích" as often as it is "Màu".
  optionImageGroup Int?

  media        ProductMedia[]
  optionImages ProductOptionImage[]
  collections  CollectionProduct[]
  variants     ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

/// One sellable combination: "30ml / Đỏ", or just "30ml" when the product has
/// only one option group. A product with no variants keeps behaving exactly as
/// before, which is why none of the 211 existing ones needed migrating.
model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  option1Value String
  // Null when the product has one option group. Postgres treats nulls as
  // distinct, so the unique index below cannot catch duplicates in that case;
  // the service rejects them instead, where the whole submitted set is visible
  // at once.
  option2Value String?

  price     Decimal? @db.Decimal(12, 0)
  // Governed by the product's sale window, not its own. A promotion is a
  // period the shop runs, and asking for start and end on each of twelve rows
  // would guarantee they drift apart.
  salePrice Decimal? @db.Decimal(12, 0)

  // Overrides the product's label for this combination — "Hết hàng" on one
  // colour while the others are in stock. Falls back to the product's.
  stockLabel String?
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)

  @@unique([productId, option1Value, option2Value])
  @@index([productId])
  @@map("product_variants")
}

// The photo that stands for one option value — "Đỏ" → this picture.
//
// Keyed by value, not by variant: three sizes in four colours is twelve
// variants but four photographs, and hanging the image on the row would have
// the owner pick the same file three times per colour.
//
// The media must already be in the product's own gallery. That is what makes
// the picker a choice among the four photos this product has rather than a
// search through the whole library, and it means picking a colour can simply
// bring that photo to the top of the gallery instead of inserting a picture
// from nowhere.
model ProductOptionImage {
  productId String
  // A value of whichever group Product.optionImageGroup names. Unique per
  // product on its own, since values within one group are already distinct.
  value     String
  mediaId   String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([productId, value])
  @@index([mediaId])
  @@map("product_option_images")
}

model Media {
  id        String   @id @default(uuid())
  // S3 object key, e.g. "products/2026/10/uuid.webp"
  key       String
  url       String
  mediaType String
  filename  String
  createdAt DateTime @default(now())

  products     ProductMedia[]
  optionImages ProductOptionImage[]
  banners      Banner[]
  categories   Category[]
  collections  Collection[]

  @@map("media")
}

model ProductMedia {
  productId String
  mediaId   String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([productId, mediaId])
  @@map("product_media")
}

model Collection {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  products CollectionProduct[]

  // Same deal as a category's: left empty, the landing borrows the first photo
  // of the first product in the collection, so a new collection is never a
  // hole in the homepage row.
  coverMediaId String?
  cover        Media?  @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("collections")
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@map("collection_products")
}

model Banner {
  id        String   @id @default(uuid())
  title     String?
  linkUrl   String?
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id])
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

model ContactChannel {
  id        String  @id @default(uuid())
  // e.g. "zalo" | "phone" | "messenger" | "facebook" | "telegram"
  type      String
  label     String?
  // phone number / url / username depending on type
  value     String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  @@map("contact_channels")
}

// Single-row settings table — enforced by a fixed id=1, not a list.
// Holds the shop's own identity too, so the landing never hardcodes a brand
// name: the same codebase can be handed to a different shop by editing these
// fields instead of editing templates.
model SiteSettings {
  id             Int     @id @default(1)
  shopName       String?
  tagline        String?
  // A few sentences of shop introduction, shown in the corner of the home
  // hero. Separate from seoDescription, which is written for search results
  // and is never read by a visitor.
  intro          String?
  seoDescription String?
  address        String?
  businessHours  String?

  @@map("site_settings")
}

// Intentionally no `role` column — single admin account only (multi-tenant/role
// support was explicitly deferred, see project memory).
model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}
