# Two kinds of variable live here, and the difference matters to whatever
# reads this file — a deploy platform treats every name it finds as one the
# app expects to be given.
#
#   Uncommented  — must be set in production. The in-code fallback is either
#                  unsafe (JWT_SECRET defaults to "change-me") or simply wrong
#                  (empty S3 credentials: images display but no upload works).
#   Commented    — a knob with a sane default. Set one only to change it.

# ── Must be set ────────────────────────────────────────────────────────────

PORT=3200

# Local development only. In production the platform issues this for the
# database it manages — setting it yourself there points at the wrong one.
DATABASE_URL="postgresql://binloves:binloves@localhost:55433/binloves?schema=public"

# Public address of the site, used for canonical URLs. Without it the app
# falls back to the host the proxy forwards, which is right only as long as
# the proxy sends one.
SITE_URL="https://example.com"

JWT_SECRET="change-me-to-a-long-random-string"

# Where new uploads go. Any S3-compatible storage: leave S3_ENDPOINT empty for
# AWS S3, set it for Cloudflare R2, DigitalOcean Spaces, MinIO, etc.
S3_ENDPOINT="https://<cloudflare-account-id>.r2.cloudflarestorage.com"
S3_BUCKET="binloves"
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public prefix for uploaded files; the bucket must allow public reads. On R2
# this is a custom domain bound to the bucket — the r2.dev address is rate
# limited and Cloudflare says not to serve production traffic from it.
S3_PUBLIC_BASE_URL="https://cdn.binloves.io.vn"

# ── The bucket uploads used to go to ───────────────────────────────────────
# Every file uploaded before the move keeps its own absolute URL in the
# database and keeps serving itself from here; nothing new is ever written.
# These exist only so that deleting such a file from the admin still reaches
# the object instead of leaving a file nobody can see but everybody pays for.
# Delete these six lines once the old bucket is empty.
LEGACY_S3_ENDPOINT=""
LEGACY_S3_BUCKET="bin-loves-s3"
LEGACY_S3_REGION="ap-southeast-2"
LEGACY_S3_ACCESS_KEY_ID=""
LEGACY_S3_SECRET_ACCESS_KEY=""
LEGACY_S3_PUBLIC_BASE_URL="https://bin-loves-s3.s3.ap-southeast-2.amazonaws.com"

# No admin credentials here on purpose. The first account is created by a
# migration, so a restart can never overwrite a password the owner changed:
#
#   node scripts/make-admin-migration.js owner@example.com
#
# The password is hashed locally; only the hash reaches the repository.

# ── Optional, defaults shown ───────────────────────────────────────────────

# How long the landing holds one API snapshot before refetching, in ms.
# Saving in the admin drops it immediately, so this does not affect how fast
# an edit appears. It bounds only what changes with nobody editing: a timed
# sale stops showing within this long of its end.
# SNAPSHOT_TTL_MS=60000

# JWT_EXPIRES_IN="7d"

# How long an upload URL stays valid. The multipart one is a day because a
# large video is uploaded part by part from a phone, and that upload has to
# survive the connection dropping and being resumed.
# S3_PRESIGN_EXPIRES_IN=3600
# S3_MULTIPART_PRESIGN_EXPIRES_IN=86400

# Where the landing reads the snapshot from. Both run in one process, so the
# default loops back to this app's own port and is right in every deployment
# this repo describes.
# API_URL="http://127.0.0.1:3200/api/v1"
