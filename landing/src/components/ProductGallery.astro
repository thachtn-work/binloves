---
import type { MediaItem } from '../lib/snapshot';
import MediaFrame from './MediaFrame.astro';
import { sized, srcSet } from '../lib/image';
import { ratioStyle } from '../lib/format';

interface Props {
  media: MediaItem[];
  /** The product's name, for the alt text of every frame. */
  name: string;
}

const { media, name } = Astro.props;

/*
  One frame for the whole gallery, not one per file.

  A carousel whose frame changed shape between slides would move the page under
  whoever is swiping it, so the shape is decided once here. It is the shape most
  of the files share — ties going to the file the owner put first — because that
  is the choice that leaves the fewest pictures letterboxed. Nothing is ever
  cropped to fit it: the stage draws every file whole (`object-fit: contain`),
  and the frame's own background fills whatever is left over.
*/
const ratioOf = (item: MediaItem) => item.displayRatio ?? '1:1';

let stageRatio = media.length ? ratioOf(media[0]) : '1:1';
let best = 0;
for (const item of media) {
  const key = ratioOf(item);
  const count = media.filter((m) => ratioOf(m) === key).length;
  if (count > best) {
    best = count;
    stageRatio = key;
  }
}

const many = media.length > 1;
const noun = (item: MediaItem) => (item.mediaType === 'video' ? 'video' : 'ảnh');
---

<div class="gallery" data-gallery>
  <div class="stage" style={ratioStyle(stageRatio)}>
    <div
      class="track"
      data-track
      role="group"
      aria-roledescription="carousel"
      aria-label={`Hình ảnh ${name}`}
      tabindex="0"
    >
      {
        media.length > 0 ? (
          media.map((item, index) => (
            <div class="slide" data-slide data-media-url={item.url}>
              <div class="media stage-media">
                <MediaFrame
                  item={item}
                  alt={`${name} — ${noun(item)} ${index + 1}`}
                  width={800}
                  height={800}
                  eager={index === 0}
                  sizes="(max-width: 900px) 100vw, 560px"
                  behaviour="full"
                />
                <button type="button" class="reveal-btn" aria-label={`Xem ${noun(item)}`}>
                  Xem {noun(item)}
                </button>
              </div>
            </div>
          ))
        ) : (
          <div class="slide">
            <div class="media stage-media">
              <div class="placeholder" aria-hidden="true" />
            </div>
          </div>
        )
      }
    </div>

    {
      /*
        Arrows only where there is a pointer to hover them with. On a phone the
        stage is swiped and the strip below says where you are, so an arrow
        would only cover a corner of the picture it is there to help read.
      */
      many && (
        <>
          <button type="button" class="arrow arrow-prev" data-prev aria-label="Ảnh trước">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M15 5 8 12l7 7" />
            </svg>
          </button>
          <button type="button" class="arrow arrow-next" data-next aria-label="Ảnh kế tiếp">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </>
      )
    }
  </div>

  {
    many && (
      <div class="strip" data-strip>
        {media.map((item, index) => (
          <button
            type="button"
            class="thumb"
            data-thumb
            aria-label={`${noun(item) === 'video' ? 'Video' : 'Ảnh'} ${index + 1}`}
            aria-current={index === 0 ? 'true' : 'false'}
          >
            {item.mediaType === 'video' ? (
              <span class="thumb-clip" aria-hidden="true" />
            ) : (
              <img
                class="thumb-img"
                src={sized(item.url, 160)}
                srcset={srcSet(item.url, 160)}
                sizes="80px"
                alt=""
                width={160}
                height={160}
                loading="lazy"
                decoding="async"
              />
            )}
            {/*
              What the tile falls back to with discreet mode on. A 72px square
              under the blur the stage uses is an unreadable smudge that still
              takes up the row, so the strip drops to plain numbers instead —
              the same trade the option swatches make. It still navigates.
            */}
            <span class="thumb-no" aria-hidden="true">
              {index + 1}
            </span>
          </button>
        ))}
      </div>
    )
  }
</div>

<script>
  function initGalleries() {
    document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = 'true';

      const track = root.querySelector<HTMLElement>('[data-track]');
      const strip = root.querySelector<HTMLElement>('[data-strip]');
      const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
      const thumbs = [...root.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
      if (!track || slides.length < 2) return;

      const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const behavior: ScrollBehavior = smooth ? 'smooth' : 'auto';
      let index = 0;

      /*
        The stage is a scroll-snap strip, not a transformed track: that is what
        gives a phone the swipe it already expects, with the browser doing the
        physics. Every control below moves the same scroll position, so the
        arrows, the thumbnails and a finger can never disagree about which
        picture is showing.
      */
      function scrollToIndex(next: number) {
        const target = Math.max(0, Math.min(next, slides.length - 1));
        track!.scrollTo({ left: target * track!.clientWidth, behavior });
      }

      function centreThumb(at: number) {
        const thumb = thumbs[at];
        if (!strip || !thumb) return;
        // Measured against the strip rather than handed to scrollIntoView,
        // which would also scroll the page vertically to reach it.
        const left = thumb.offsetLeft - (strip.clientWidth - thumb.clientWidth) / 2;
        strip.scrollTo({ left: Math.max(0, left), behavior });
      }

      function mark(at: number) {
        if (at === index) return;
        index = at;
        thumbs.forEach((t, i) => t.setAttribute('aria-current', String(i === at)));
        centreThumb(at);
      }

      let ticking = false;
      track.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          const width = track!.clientWidth;
          if (width) mark(Math.round(track!.scrollLeft / width));
        });
      });

      root.querySelector('[data-prev]')?.addEventListener('click', () => scrollToIndex(index - 1));
      root.querySelector('[data-next]')?.addEventListener('click', () => scrollToIndex(index + 1));
      thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => scrollToIndex(i)));

      track.addEventListener('keydown', (event) => {
        // A clip's own player uses these keys to seek; it gets them first.
        if (event.target instanceof HTMLVideoElement) return;
        if (event.key === 'ArrowLeft') scrollToIndex(index - 1);
        else if (event.key === 'ArrowRight') scrollToIndex(index + 1);
        else return;
        event.preventDefault();
      });

      /*
        One reveal clears the whole gallery, not just the slide showing.
        Stacked down a column every photo had its own button and the visitor
        passed each one anyway; behind a carousel the same promise would cost
        a tap per swipe. Asking once is still asking.

        Captured on the way down because the shared handler on the button stops
        the event bubbling — a listener waiting here would never hear it.
      */
      root.addEventListener(
        'click',
        (event) => {
          const target = event.target;
          if (!(target instanceof Element) || !target.closest('.reveal-btn')) return;
          root.querySelectorAll('.media').forEach((m) => m.classList.add('is-revealed'));
        },
        true,
      );

      /*
        How the variant chips ask for a picture. They know a url and nothing
        about this carousel, which is the point: the gallery can change shape
        again without the chips having to hear about it.
      */
      root.addEventListener('gallery:show', (event) => {
        const url = (event as CustomEvent<{ url: string }>).detail?.url;
        const at = slides.findIndex((s) => s.dataset.mediaUrl === url);
        if (at >= 0) scrollToIndex(at);
      });
    });
  }

  initGalleries();
  document.addEventListener('astro:after-swap', initGalleries);
</script>

<style>
  .gallery {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }

  .stage {
    position: relative;
    aspect-ratio: var(--ratio, 1);
    /*
      A 9:16 frame at this column's width runs past the bottom of the screen,
      and the Zalo button beside it is the only thing to do on the page.

      `width: 100%` is what makes the ceiling behave, and it is not optional.
      A grid item that carries an aspect ratio is laid out from its start edge
      rather than stretched, so its width is indefinite — and a height ceiling
      meeting an aspect ratio then pulls the *width* down to match, which came
      out as a 374px stage in a 580px column. With the width pinned the ratio
      is what gives way, and the picture letterboxes inside what is left.
    */
    width: 100%;
    max-height: 70vh;
  }

  .track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .track:focus-visible {
    outline: 2px solid var(--indigo);
    outline-offset: 3px;
  }

  .slide {
    flex: 0 0 100%;
    min-width: 0;
    height: 100%;
    scroll-snap-align: center;
  }

  .stage-media {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-lg);
  }

  /*
    Whole, never cropped. One frame now stands in for files of three different
    shapes, and a shop's detail page is the one place where the half of a
    picture a crop would eat is the half the customer came to look at.
  */
  .stage-media :global(.media-el) {
    object-fit: contain;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--card), var(--well));
  }

  .arrow {
    position: absolute;
    inset-block-start: 50%;
    translate: 0 -50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--card);
    box-shadow: var(--shadow-sm);
    color: var(--text-soft);
    cursor: pointer;
    transition:
      color 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }

  .arrow:hover {
    color: var(--indigo);
    box-shadow: var(--shadow-md);
  }

  .arrow:active {
    box-shadow: var(--shadow-inset);
  }

  .arrow svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .arrow-prev {
    inset-inline-start: var(--space-3);
  }

  .arrow-next {
    inset-inline-end: var(--space-3);
  }

  /* Swipe and the strip already do this where there is no pointer. */
  @media (hover: none) {
    .arrow {
      display: none;
    }
  }

  .strip {
    position: relative; /* the offset the thumbnails are centred against */
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    scrollbar-width: none;
    padding-block: var(--space-1);
  }

  .strip::-webkit-scrollbar {
    display: none;
  }

  .thumb {
    position: relative;
    flex: 0 0 auto;
    width: 72px;
    height: 72px;
    padding: 0;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: var(--radius);
    background: var(--well);
    box-shadow: var(--shadow-sm);
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }

  .thumb:hover {
    border-color: var(--line-strong);
  }

  .thumb[aria-current='true'] {
    border-color: var(--indigo);
    box-shadow: var(--shadow-inset);
  }

  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* A clip's tile carries a play mark rather than its first frame: that frame
     is a product photo too, and loading one per clip to show it 72px wide
     spends a phone's data on a picture the stage is already holding. */
  .thumb-clip {
    position: absolute;
    inset: 0;
  }

  .thumb-clip::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    transform: translate(-40%, -50%);
    border-style: solid;
    border-width: 7px 0 7px 12px;
    border-color: transparent transparent transparent var(--text-dim);
  }

  .thumb-no {
    position: absolute;
    inset: 0;
    display: none;
    place-items: center;
    color: var(--text-dim);
    font-size: var(--text-sm);
  }

  :root[data-discreet='on'] .thumb-img {
    display: none;
  }

  :root[data-discreet='on'] .thumb-no {
    display: grid;
  }

  @media (max-width: 900px) {
    /*
      Edge to edge on a phone, where the picture is the page. The strip stays
      inside the shell's gutter so it reads as a row of controls under the
      stage rather than another thing running off the screen.
    */
    .stage {
      /* Out through the shell's gutter on both sides. Widened rather than
         pulled by margins alone: the width above is pinned at 100%, and a
         negative margin on each side of a pinned width moves the frame left
         without making it any wider. */
      width: calc(100% + var(--space-5) * 2);
      margin-inline: calc(var(--space-5) * -1);
    }

    .track {
      border-radius: 0;
      box-shadow: none;
    }

    .stage-media {
      border-radius: 0;
    }
  }
</style>
