---
import type { Product } from '../lib/snapshot';
import { priceDisplay } from '../lib/format';
import MediaFrame from './MediaFrame.astro';

interface Props {
  product: Product;
  /** Eager-load only the handful of cards above the fold. */
  priority?: boolean;
}

const { product, priority = false } = Astro.props;
const cover = product.media[0];
// One reading for both shapes: a product with option groups prints the range
// across its variants, one without prints its single price.
const { now, was, discount } = priceDisplay(product);
// The reveal control names what is behind the blur; calling a clip an image
// would misdescribe the only thing the visitor is being asked to decide about.
const coverNoun = cover?.mediaType === 'video' ? 'video' : 'ảnh';
---

<a class="card" href={`/san-pham/${product.slug}`}>
  <div class="media">
    {
      cover ? (
        <MediaFrame item={cover} alt={product.name} width={400} height={400} eager={priority} />
      ) : (
        <div class="media-placeholder" aria-hidden="true" />
      )
    }

    {discount !== null && <span class="badge-sale">-{discount}%</span>}

    <button type="button" class="reveal-btn" aria-label={`Xem ${coverNoun} ${product.name}`}>
      Xem {coverNoun}
    </button>
  </div>

  <div class="card-body">
    <h3 class="card-name">{product.name}</h3>

    <p class="card-price">
      <span class="now">{now}</span>
      {was && <s class="was">{was}</s>}
    </p>

    {product.stockLabel && <p class="card-stock">{product.stockLabel}</p>}
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    border-radius: var(--radius);
    transition: transform 0.3s var(--ease);
  }

  .card:hover {
    transform: translateY(-3px);
  }

  /* Most product shots are on white studio backgrounds. On a near-black page
     they float unless something holds them, so the frame is drawn rather than
     implied. The photos themselves are left true — a tint belongs on the
     category circles, which are navigation, not on what is being sold. */
  .media {
    aspect-ratio: 1;
    border-radius: var(--radius);
    border: 1px solid var(--line-strong);
  }

  .card:hover .media .media-el {
    transform: scale(1.03);
  }

  .media-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--card), var(--well));
  }

  .badge-sale {
    position: absolute;
    inset-block-start: var(--space-2);
    inset-inline-start: var(--space-2);
    z-index: 2;
    padding: 2px var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--indigo);
    color: var(--paper);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .card-name {
    font-family: var(--font-body);
    /* h3 narrows the display face; the body face has no width axis, so this
       stops the browser synthesising a squeeze on 230px of Vietnamese caps. */
    font-stretch: normal;
    letter-spacing: 0;
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-price {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .now {
    color: var(--indigo);
    font-weight: 600;
    font-size: var(--text-base);
  }

  .was {
    color: var(--text-dim);
    font-size: var(--text-sm);
  }

  .card-stock {
    font-size: var(--text-xs);
    color: var(--text-soft);
  }
</style>
