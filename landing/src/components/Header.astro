---
import type { Category, ContactChannel } from '../lib/snapshot';
import { findChannel, zaloLink } from '../lib/format';
import DiscreetToggle from './DiscreetToggle.astro';

interface Props {
  shopName: string;
  categories: Category[];
  contactChannels: ContactChannel[];
}

const { shopName, categories, contactChannels } = Astro.props;
const zalo = findChannel(contactChannels, 'zalo');
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="shell header-inner">
    <a href="/" class="wordmark" aria-label={`${shopName} — về trang chủ`}>
      <span>{shopName}</span>
    </a>

    <form class="search" action="/tim-kiem" method="get" role="search">
      <label for="q" class="sr-only">Tìm sản phẩm</label>
      <input
        type="search"
        id="q"
        name="q"
        placeholder="Tìm sản phẩm…"
        autocomplete="off"
        enterkeyhint="search"
      />
    </form>

    <div class="header-actions">
      <DiscreetToggle />
      {
        zalo && (
          <a class="btn btn-zalo" href={zaloLink(zalo)} target="_blank" rel="noopener noreferrer">
            Nhắn Zalo
          </a>
        )
      }
    </div>
  </div>
</header>

{/*
  Outside the sticky header on purpose. `position: sticky` is bounded by its
  own parent, so a strip that needs to stop being pinned on a phone cannot
  simply opt out from inside one — it has to not be in there.
*/}
{
  categories.length > 0 && (
    <nav class="catnav" aria-label="Danh mục sản phẩm">
      <div class="shell catnav-inner">
        {categories.map((c) => (
          <a
            href={`/danh-muc/${c.slug}`}
            class:list={['catnav-link', { 'is-active': currentPath === `/danh-muc/${c.slug}` }]}
          >
            {c.name}
          </a>
        ))}
      </div>
    </nav>
  )
}

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .search {
    flex: 1;
    min-width: 0;
  }

  .search input {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--text);
    font-size: var(--text-sm);
    transition: border-color 0.2s var(--ease);
  }

  .search input::placeholder {
    color: var(--text-dim);
  }

  .search input:focus {
    border-color: var(--indigo);
    outline: none;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* Sticks under the bar above it, which is why its own `top` is the bar's
     height rather than 0. The height is measured rather than guessed: it
     follows the font size and the Zalo button, and a wrong constant here
     would show as a sliver of page between the two pinned strips. */
  .catnav {
    position: sticky;
    top: var(--header-h, 0px);
    z-index: 49;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(14px);
    border-top: 1px solid var(--line);
    overflow-x: auto;
    scrollbar-width: none;
    /* The strip is wider than any screen and has no scrollbar, so the last
       name sat cut in half with nothing to say it could be dragged. Fading
       the edge is that signal: a word dissolving reads as "more over here"
       where a hard crop reads as a mistake. */
    mask-image: linear-gradient(to right, #000 calc(100% - 48px), transparent);
  }

  .catnav::-webkit-scrollbar {
    display: none;
  }

  .catnav-inner {
    display: flex;
    gap: var(--space-5);
    padding-block: var(--space-3);
    white-space: nowrap;
  }

  .catnav-link {
    font-size: var(--text-sm);
    color: var(--text-soft);
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .catnav-link:hover {
    color: var(--text);
  }

  .catnav-link.is-active {
    color: var(--indigo);
    border-color: var(--indigo);
  }

  @media (max-width: 760px) {
    .header-inner {
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-3);
      padding-block: var(--space-3);
    }

    /* Name, the discreet control and Zalo share the first line; search takes
       the second. Giving the wordmark `flex: 1` used to push the other two
       onto a line of their own, so the header stood three rows tall and ate
       most of a phone screen before the shop appeared. */
    .wordmark {
      font-size: var(--text-lg);
    }

    .header-actions {
      margin-inline-start: auto;
    }

    .search {
      order: 3;
      flex-basis: 100%;
    }

    /*
      The category strip stops being pinned. It is wider than a phone and has
      to be scrolled sideways, which is awkward enough without it also holding
      a fifth of the screen on every page — it scrolls away with the content
      now, while the bar above it stays.
    */
    .catnav {
      position: static;
      border-top: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>

<script>
  // The category strip pins itself directly under the bar above it, and only
  // the browser knows how tall that bar ended up — it follows the font and
  // the Zalo button. Published as a custom property so the CSS can stay
  // declarative instead of a constant that drifts the next time either moves.
  function measure() {
    const header = document.querySelector<HTMLElement>('.site-header');
    if (!header) return;
    document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
  }

  measure();
  addEventListener('resize', measure);
  document.addEventListener('astro:after-swap', measure);
</script>
