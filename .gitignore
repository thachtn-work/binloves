# Dependencies and build output
node_modules/
dist/
.astro/
*.tsbuildinfo

# Secrets. No leading slash on purpose: this has to catch backend/.env as well
# as the one at the root, and any .env a future package brings with it.
# `.env.example` is deliberately not matched — it is the template, with no
# real values in it.
.env
.env.*
!.env.example

# Local noise
*.log
.DS_Store
